<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="account_tag_view_search" model="ir.ui.view">
        <field name="name">account.tag - search</field>
        <field name="model">account.tag</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="country_id" />
                <filter
                    name="filter_accounts"
                    string="Accounts"
                    domain="[('applicability', '=', 'accounts')]"
                />
                <filter
                    name="filter_taxes"
                    string="Taxes"
                    domain="[('applicability', '=', 'taxes')]"
                />
                <!-- Group By -->
                <group>
                    <filter
                        name="group_by_applicability"
                        string="Applicability"
                        context="{'group_by': 'applicability'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <record id="account_tag_view_list" model="ir.ui.view">
        <field name="name">account.tag - list</field>
        <field name="model">account.tag</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="applicability" />
                <field name="country_id" />
                <field name="color" column_invisible="1" />
            </list>
        </field>
    </record>

    <record id="account_tag_view_form" model="ir.ui.view">
        <field name="name">account.tag - form</field>
        <field name="model">account.tag</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group name="main_group">
                        <field name="name" />
                        <field name="applicability" />
                        <field name="country_id" />
                        <field name="color" widget="color_picker" />
                        <field name="active" invisible="1" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="account_tag_action" model="ir.actions.act_window">
        <field name="name">Account Tags</field>
        <field name="res_model">account.tag</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'active_test': False}</field>
    </record>

    <menuitem
        id="account_tag_menu"
        parent="menu_accounting_configuration"
        action="account_tag_action"
        sequence="20"
    />
</odoo>
