<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="tax_group_view_search" model="ir.ui.view">
        <field name="name">tax_group - search</field>
        <field name="model">tax_group</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="company_id" />
                <field name="country_id" />
                <!-- Group By -->
                <group>
                    <filter
                        name="group_by_company"
                        string="Company"
                        context="{'group_by': 'company_id'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <record id="tax_group_view_list" model="ir.ui.view">
        <field name="name">tax_group - list</field>
        <field name="model">tax_group</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle" />
                <field name="name" />
                <field name="country_id" />
                <field name="company_id" groups="base.group_multi_company" />
            </list>
        </field>
    </record>

    <record id="tax_group_view_form" model="ir.ui.view">
        <field name="name">tax_group - form</field>
        <field name="model">tax_group</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group name="main_group">
                        <group name="main_group_left">
                            <field name="name" />
                            <field name="sequence" />
                            <field
                                name="company_id"
                                groups="base.group_multi_company"
                            />
                            <field name="country_id" />
                        </group>
                        <group name="main_group_right">
                            <field name="preceding_subtotal" />
                            <field name="tax_payable_account_id" />
                            <field name="tax_receivable_account_id" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="tax_group_action" model="ir.actions.act_window">
        <field name="name">Tax Groups</field>
        <field name="res_model">tax_group</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="tax_group_menu"
        parent="menu_accounting_configuration"
        action="tax_group_action"
        sequence="50"
    />
</odoo>
