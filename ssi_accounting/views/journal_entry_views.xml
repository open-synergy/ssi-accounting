<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="journal_entry_view_search" model="ir.ui.view">
        <field name="name">journal_entry - search</field>
        <field name="model">journal_entry</field>
        <field name="arch" type="xml">
            <search string="Journal Entries">
                <field name="name" />
                <field name="ref" />
                <field name="journal_id" />
                <field name="partner_id" />
                <filter
                    name="filter_draft"
                    string="Draft"
                    domain="[('state', '=', 'draft')]"
                />
                <filter
                    name="filter_posted"
                    string="Posted"
                    domain="[('state', '=', 'posted')]"
                />
                <filter
                    name="filter_cancelled"
                    string="Cancelled"
                    domain="[('state', '=', 'cancel')]"
                />
                <separator />
                <filter
                    name="filter_this_month"
                    string="This Month"
                    domain="[
                        ('date', '&gt;=', context_today().strftime('%Y-%m-01')),
                        ('date', '&lt;', (context_today() + relativedelta(months=1)).strftime('%Y-%m-01')),
                    ]"
                />
                <!-- Group By -->
                <group>
                    <filter
                        name="group_by_journal"
                        string="Journal"
                        context="{'group_by': 'journal_id'}"
                    />
                    <filter
                        name="group_by_partner"
                        string="Partner"
                        context="{'group_by': 'partner_id'}"
                    />
                    <filter
                        name="group_by_state"
                        string="Status"
                        context="{'group_by': 'state'}"
                    />
                    <filter
                        name="group_by_date"
                        string="Date"
                        context="{'group_by': 'date'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <record id="journal_entry_view_list" model="ir.ui.view">
        <field name="name">journal_entry - list</field>
        <field name="model">journal_entry</field>
        <field name="arch" type="xml">
            <list string="Journal Entries">
                <field name="date" />
                <field name="name" />
                <field name="ref" />
                <field name="journal_id" />
                <field name="partner_id" />
                <field name="amount_total_debit" />
                <field name="amount_total_credit" />
                <field name="state" />
                <field name="company_id" groups="base.group_multi_company" />
            </list>
        </field>
    </record>

    <record id="journal_entry_view_form" model="ir.ui.view">
        <field name="name">journal_entry - form</field>
        <field name="model">journal_entry</field>
        <field name="arch" type="xml">
            <form string="Journal Entry">
                <header>
                    <button
                        name="action_post"
                        string="Post"
                        type="object"
                        class="oe_highlight"
                        invisible="state != 'draft'"
                    />
                    <button
                        name="button_draft"
                        string="Reset to Draft"
                        type="object"
                        invisible="not show_reset_to_draft_button"
                    />
                    <button
                        name="button_cancel"
                        string="Cancel"
                        type="object"
                        invisible="state not in ('draft', 'posted')"
                        confirm="Are you sure you want to cancel this journal entry?"
                    />
                    <button
                        name="action_reverse"
                        string="Reverse Entry"
                        type="object"
                        invisible="state != 'posted'"
                    />
                    <field name="state" widget="statusbar" />
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button
                            name="action_view_reversal_moves"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-history"
                            invisible="reversal_move_count == 0"
                        >
                            <field
                                name="reversal_move_count"
                                widget="statinfo"
                                string="Reversals"
                            />
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name" />
                        <h1>
                            <field
                                name="name"
                                readonly="state != 'draft'"
                                options="{'placeholder_field': 'name_placeholder'}"
                            />
                        </h1>
                    </div>
                    <field name="name_placeholder" invisible="1" />
                    <field name="highest_name" invisible="1" />
                    <group>
                        <group name="main_group">
                            <field
                                name="journal_id"
                                domain="[('id', 'in', suitable_journal_ids)]"
                                readonly="state != 'draft'"
                            />
                            <field name="date" readonly="state != 'draft'" />
                            <field name="ref" readonly="state != 'draft'" />
                            <field
                                name="reversed_entry_id"
                                readonly="1"
                                invisible="not reversed_entry_id"
                            />
                        </group>
                        <group name="secondary_group">
                            <field name="partner_id" readonly="state != 'draft'" />
                            <field
                                name="currency_id"
                                groups="base.group_multi_currency"
                                readonly="state != 'draft'"
                            />
                            <field
                                name="company_id"
                                groups="base.group_multi_company"
                            />
                        </group>
                    </group>
                    <notebook>
                        <page name="journal_items" string="Journal Items">
                            <field name="line_ids" readonly="state != 'draft'">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle" />
                                    <field name="account_id" />
                                    <field name="name" />
                                    <field name="partner_id" />
                                    <field name="product_id" optional="hide" />
                                    <field name="quantity" optional="hide" />
                                    <field name="price_unit" optional="hide" />
                                    <field name="debit" sum="Total Debit" />
                                    <field name="credit" sum="Total Credit" />
                                    <field
                                        name="currency_id"
                                        groups="base.group_multi_currency"
                                    />
                                    <field
                                        name="amount_currency"
                                        groups="base.group_multi_currency"
                                    />
                                    <field
                                        name="tax_ids"
                                        widget="many2many_tags"
                                        optional="hide"
                                    />
                                    <field name="display_type" optional="hide" />
                                </list>
                            </field>
                            <group class="oe_subtotal_footer oe_right">
                                <field name="amount_total_debit" />
                                <field name="amount_total_credit" />
                            </group>
                        </page>
                        <page name="other_info" string="Other Info">
                            <group>
                                <field name="narration" />
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record id="journal_entry_action" model="ir.actions.act_window">
        <field name="name">Journal Entries</field>
        <field name="res_model">journal_entry</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="journal_entry_menu"
        name="Journal Entries"
        parent="menu_accounting_root"
        action="journal_entry_action"
        sequence="10"
    />

    <record id="journal_entry_item_view_search" model="ir.ui.view">
        <field name="name">journal_entry.item - search</field>
        <field name="model">journal_entry.item</field>
        <field name="arch" type="xml">
            <search string="Journal Items">
                <field name="move_name" />
                <field name="account_id" />
                <field name="partner_id" />
                <field name="journal_id" />
                <field name="matching_number" />
                <filter
                    name="filter_reconciled"
                    string="Reconciled"
                    domain="[('reconciled', '=', True)]"
                />
                <filter
                    name="filter_unreconciled"
                    string="Unreconciled"
                    domain="[('reconciled', '=', False), ('account_id.reconcile', '=', True)]"
                />
                <!-- Group By -->
                <group>
                    <filter
                        name="group_by_account"
                        string="Account"
                        context="{'group_by': 'account_id'}"
                    />
                    <filter
                        name="group_by_journal"
                        string="Journal"
                        context="{'group_by': 'journal_id'}"
                    />
                    <filter
                        name="group_by_partner"
                        string="Partner"
                        context="{'group_by': 'partner_id'}"
                    />
                    <filter
                        name="group_by_date"
                        string="Date"
                        context="{'group_by': 'date'}"
                    />
                    <filter
                        name="group_by_matching_number"
                        string="Matching #"
                        context="{'group_by': 'matching_number'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <record id="journal_entry_item_view_list" model="ir.ui.view">
        <field name="name">journal_entry.item - list</field>
        <field name="model">journal_entry.item</field>
        <field name="arch" type="xml">
            <list string="Journal Items" default_order="date desc, move_name desc">
                <header>
                    <button name="action_reconcile" type="object" string="Reconcile" />
                    <button
                        name="action_remove_move_reconcile"
                        type="object"
                        string="Unreconcile"
                        confirm="Are you sure you want to remove the reconciliation of the selected journal items?"
                    />
                </header>
                <field name="date" />
                <field name="move_name" />
                <field name="journal_id" />
                <field name="account_id" />
                <field name="partner_id" />
                <field name="name" />
                <field name="debit" sum="Total Debit" />
                <field name="credit" sum="Total Credit" />
                <field name="amount_residual" optional="hide" />
                <field name="matching_number" />
                <field name="reconciled" optional="hide" />
                <field name="cumulated_balance" />
                <field name="company_id" groups="base.group_multi_company" />
            </list>
        </field>
    </record>

    <record id="journal_entry_item_view_form" model="ir.ui.view">
        <field name="name">journal_entry.item - form</field>
        <field name="model">journal_entry.item</field>
        <field name="arch" type="xml">
            <form string="Journal Item">
                <sheet>
                    <field name="parent_state" invisible="1" />
                    <group>
                        <group name="main_group">
                            <field name="move_id" readonly="parent_state != 'draft'" />
                            <field name="date" readonly="parent_state != 'draft'" />
                            <field
                                name="account_id"
                                readonly="parent_state != 'draft'"
                            />
                            <field
                                name="partner_id"
                                readonly="parent_state != 'draft'"
                            />
                            <field name="name" readonly="parent_state != 'draft'" />
                        </group>
                        <group name="amount_group">
                            <field name="debit" readonly="parent_state != 'draft'" />
                            <field name="credit" readonly="parent_state != 'draft'" />
                            <field
                                name="currency_id"
                                groups="base.group_multi_currency"
                                readonly="parent_state != 'draft'"
                            />
                            <field
                                name="amount_currency"
                                groups="base.group_multi_currency"
                                readonly="parent_state != 'draft'"
                            />
                        </group>
                        <group name="reconciliation_group">
                            <field name="matching_number" readonly="1" />
                            <field name="reconciled" readonly="1" />
                            <field name="amount_residual" readonly="1" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="journal_entry_item_action" model="ir.actions.act_window">
        <field name="name">Journal Items</field>
        <field name="res_model">journal_entry.item</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('display_type', '=', 'product')]</field>
    </record>

    <menuitem
        id="journal_entry_item_menu"
        name="Journal Items"
        parent="menu_accounting_root"
        action="journal_entry_item_action"
        sequence="20"
    />
</odoo>
