<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="journal_view_search" model="ir.ui.view">
        <field name="name">account.journal - search</field>
        <field name="model">account.journal</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="code" />
                <field name="company_id" />
                <filter
                    name="filter_inactive"
                    string="Inactive Journals"
                    domain="[('active', '=', False)]"
                />
                <!-- Group By -->
                <group>
                    <filter
                        name="group_by_type"
                        string="Type"
                        context="{'group_by': 'type'}"
                    />
                    <filter
                        name="group_by_company"
                        string="Company"
                        context="{'group_by': 'company_id'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <record id="journal_view_list" model="ir.ui.view">
        <field name="name">account.journal - list</field>
        <field name="model">account.journal</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle" />
                <field name="code" />
                <field name="name" />
                <field name="type" />
                <field name="default_account_id" />
                <field name="company_id" groups="base.group_multi_company" />
            </list>
        </field>
    </record>

    <record id="journal_view_form" model="ir.ui.view">
        <field name="name">account.journal - form</field>
        <field name="model">account.journal</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button
                            class="oe_stat_button"
                            name="action_open_journal_entries"
                            type="object"
                            icon="fa-book"
                        >
                            <div class="o_stat_info">
                                <span class="o_stat_value">
                                    <field name="entry_count" />
                                </span>
                                <span class="o_stat_text">Entries</span>
                            </div>
                        </button>
                    </div>
                    <group name="main_group">
                        <field name="name" />
                        <field name="code" />
                        <field name="type" />
                        <field name="company_id" groups="base.group_multi_company" />
                        <field name="currency_id" groups="base.group_multi_currency" />
                        <field name="active" invisible="1" />
                    </group>
                    <group name="account_group">
                        <field
                            name="default_account_id"
                            domain="[('company_ids', 'in', [company_id])]"
                        />
                        <field
                            name="suspense_account_id"
                            domain="[('company_ids', 'in', [company_id])]"
                        />
                        <field
                            name="journal_group_ids"
                            widget="many2many_tags"
                            domain="[('company_id', '=', company_id)]"
                        />
                    </group>
                    <group name="sequence_group" groups="base.group_no_one">
                        <field name="sequence_override_regex" />
                    </group>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record id="journal_action" model="ir.actions.act_window">
        <field name="name">Journals</field>
        <field name="res_model">account.journal</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'active_test': False}</field>
    </record>

    <menuitem
        id="journal_menu"
        parent="menu_accounting_configuration"
        action="journal_action"
        sequence="30"
    />
</odoo>
