<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="account_group_view_search" model="ir.ui.view">
        <field name="name">account.group - search</field>
        <field name="model">account.group</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="code_prefix_start" />
                <field name="company_id" />
                <filter
                    name="filter_root"
                    string="Root Groups"
                    domain="[('parent_id', '=', False)]"
                />
                <group expand="0" string="Group By">
                    <filter
                        name="group_by_parent"
                        string="Parent"
                        context="{'group_by': 'parent_id'}"
                    />
                    <filter
                        name="group_by_company"
                        string="Company"
                        context="{'group_by': 'company_id'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <record id="account_group_view_list" model="ir.ui.view">
        <field name="name">account.group - list</field>
        <field name="model">account.group</field>
        <field name="arch" type="xml">
            <list>
                <field name="code_prefix_start" />
                <field name="code_prefix_end" />
                <field name="name" />
                <field name="parent_id" />
                <field name="company_id" groups="base.group_multi_company" />
            </list>
        </field>
    </record>

    <record id="account_group_view_form" model="ir.ui.view">
        <field name="name">account.group - form</field>
        <field name="model">account.group</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group name="main_group">
                        <field name="name" />
                        <field name="code_prefix_start" />
                        <field name="code_prefix_end" />
                        <field name="parent_id" />
                        <field name="company_id" groups="base.group_multi_company" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="account_group_action" model="ir.actions.act_window">
        <field name="name">Account Groups</field>
        <field name="res_model">account.group</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="account_group_menu"
        parent="menu_accounting_configuration"
        action="account_group_action"
        sequence="10"
    />
</odoo>
