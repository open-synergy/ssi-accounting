#. module: ssi_accounting
#. odoo-python
#: code:addons/ssi_accounting/models/res_currency.py:0
msgid ""
"\n"
"Context: Deactivate currency\n"
"Database ID: %(database_id)s\n"
"Problem: This currency has already been used to make accounting entries\n"
"Solution: Keep the currency active, or first remove/reassign the\n"
"    journal items using it\n"
msgstr ""

#. module: ssi_accounting
#. odoo-python
#: code:addons/ssi_accounting/models/account.py:0
msgid ""
"\n"
"Context: Delete account\n"
"Database ID: %(database_id)s\n"
"Problem: This account contains journal items\n"
"Solution: Remove or reassign the journal items before deleting the account\n"
msgstr ""

#. module: ssi_accounting
#. odoo-python
#: code:addons/ssi_accounting/models/account.py:0
msgid ""
"\n"
"Context: Delete account\n"
"Database ID: %(database_id)s\n"
"Problem: This account is set on the account mapping of a tax repartition\n"
"    line\n"
"Solution: Update the tax repartition line first, then delete the account\n"
msgstr ""

#. module: ssi_accounting
#. odoo-python
#: code:addons/ssi_accounting/models/journal.py:0
msgid ""
"\n"
"Context: Delete journal\n"
"Database ID: %(database_id)s\n"
"Problem: This journal already has journal entries\n"
"Solution: Remove or reassign the journal entries before deleting the\n"
"    journal\n"
msgstr ""

#. module: ssi_accounting
#. odoo-python
#: code:addons/ssi_accounting/models/account.py:0
msgid ""
"\n"
"Context: Disable reconciliation on account\n"
"Database ID: %(database_id)s\n"
"Problem: Some journal items on this account are still partially reconciled\n"
"Solution: Fully reconcile or unreconcile those items first\n"
msgstr ""

#. module: ssi_accounting
#. odoo-python
#: code:addons/ssi_accounting/models/account.py:0
msgid ""
"\n"
"Context: Generate new account code\n"
"Database ID: %(database_id)s\n"
"Problem: Cannot generate an unused account code from %(start_code)s\n"
"Solution: Set the account code manually\n"
msgstr ""

#. module: ssi_accounting
#. odoo-python
#: code:addons/ssi_accounting/models/journal.py:0
msgid ""
"\n"
"Context: Generate new journal code\n"
"Database ID: %(database_id)s\n"
"Problem: Cannot generate an unused journal code for company %(company)s\n"
"Solution: Set the journal code manually\n"
msgstr ""

#. module: ssi_accounting
#. odoo-python
#: code:addons/ssi_accounting/models/journal_entry.py:0
msgid ""
"\n"
"Context: Post journal entry\n"
"Database ID: %(database_id)s\n"
"Problem: The date %(old_date)s falls within a locked period (%(lock_date_info)s)\n"
"Solution: The entry is accounted on %(new_date)s instead\n"
msgstr ""

#. module: ssi_accounting
#. odoo-python
#: code:addons/ssi_accounting/models/journal_entry.py:0
msgid ""
"\n"
"Context: Post journal entry\n"
"Problem: %(problems)s\n"
"Solution: Fix the listed issue(s), then post again\n"
msgstr ""

#. module: ssi_accounting
#. odoo-python
#: code:addons/ssi_accounting/models/journal_entry_item.py:0
msgid ""
"\n"
"Context: Reconcile journal items\n"
"Problem: Account %(account)s does not allow reconciliation\n"
"Solution: Enable \"Allow Reconciliation\" on the account first\n"
msgstr ""

#. module: ssi_accounting
#. odoo-python
#: code:addons/ssi_accounting/models/journal_entry_item.py:0
msgid ""
"\n"
"Context: Reconcile journal items\n"
"Problem: Some of the selected journal items are already reconciled\n"
"Solution: Unreconcile them first, or remove them from the selection\n"
msgstr ""

#. module: ssi_accounting
#. odoo-python
#: code:addons/ssi_accounting/models/journal_entry_item.py:0
msgid ""
"\n"
"Context: Reconcile journal items\n"
"Problem: Some of the selected journal items belong to an entry that is\n"
"    not posted\n"
"Solution: Post the journal entry first, then reconcile\n"
msgstr ""

#. module: ssi_accounting
#. odoo-python
#: code:addons/ssi_accounting/models/journal_entry_item.py:0
msgid ""
"\n"
"Context: Reconcile journal items\n"
"Problem: The selected journal items are not on the same account:\n"
"    %(accounts)s\n"
"Solution: Select journal items on a single account\n"
msgstr ""

#. module: ssi_accounting
#. odoo-python
#: code:addons/ssi_accounting/models/journal_entry_item.py:0
msgid ""
"\n"
"Context: Reconcile journal items\n"
"Problem: The selected journal items don't belong to the same company:\n"
"    %(companies)s\n"
"Solution: Select journal items within a single company\n"
msgstr ""

#. module: ssi_accounting
#. odoo-python
#: code:addons/ssi_accounting/models/journal_entry_item.py:0
msgid ""
"\n"
"Context: Reconcile journal items in different currencies\n"
"Problem: No exchange difference journal is configured for this company\n"
"Solution: Set the \"Exchange Difference Journal\" in the company's Currency Exchange settings, then reconcile again\n"
msgstr ""

#. module: ssi_accounting
#. odoo-python
#: code:addons/ssi_accounting/models/journal_entry_item.py:0
msgid ""
"\n"
"Context: Reconcile journal items in different currencies\n"
"Problem: No gain exchange rate account is configured for this company\n"
"Solution: Set the \"Gain Exchange Rate Account\" in the company's Currency Exchange settings, then reconcile again\n"
msgstr ""

#. module: ssi_accounting
#. odoo-python
#: code:addons/ssi_accounting/models/journal_entry_item.py:0
msgid ""
"\n"
"Context: Reconcile journal items in different currencies\n"
"Problem: No loss exchange rate account is configured for this company\n"
"Solution: Set the \"Loss Exchange Rate Account\" in the company's Currency Exchange settings, then reconcile again\n"
msgstr ""

#. module: ssi_accounting
#. odoo-python
#: code:addons/ssi_accounting/wizards/journal_entry_reversal.py:0
msgid ""
"\n"
"Context: Reverse journal entry\n"
"Problem: No journal entry was selected\n"
"Solution: Select at least one posted journal entry to reverse\n"
msgstr ""

#. module: ssi_accounting
#. odoo-python
#: code:addons/ssi_accounting/wizards/journal_entry_reversal.py:0
msgid ""
"\n"
"Context: Reverse journal entry\n"
"Problem: The following entries are not posted, so cannot be reversed:\n"
"%(entries)s\n"
"Solution: Select only posted journal entries\n"
msgstr ""

#. module: ssi_accounting
#. odoo-python
#: code:addons/ssi_accounting/models/account.py:0
msgid ""
"\n"
"Context: Save account\n"
"Database ID: %(database_id)s\n"
"Problem: Bank and Cash accounts cannot be shared between companies\n"
"Solution: Assign a single company to this account\n"
msgstr ""

#. module: ssi_accounting
#. odoo-python
#: code:addons/ssi_accounting/models/account.py:0
msgid ""
"\n"
"Context: Save account\n"
"Database ID: %(database_id)s\n"
"Problem: Duplicate account code(s) in company %(company)s: %(codes)s\n"
"Solution: Choose a unique code for each account within the company\n"
msgstr ""

#. module: ssi_accounting
#. odoo-python
#: code:addons/ssi_accounting/models/account.py:0
msgid ""
"\n"
"Context: Save account\n"
"Database ID: %(database_id)s\n"
"Problem: The code must be set for company %(company)s\n"
"Solution: Set a code for every company this account belongs to\n"
msgstr ""

#. module: ssi_accounting
#. odoo-python
#: code:addons/ssi_accounting/models/account.py:0
msgid ""
"\n"
"Context: Save account\n"
"Database ID: %(database_id)s\n"
"Problem: The following accounts have no company assigned:\n"
"%(accounts)s\n"
"Solution: Assign at least one company to every account\n"
msgstr ""

#. module: ssi_accounting
#. odoo-python
#: code:addons/ssi_accounting/models/account.py:0
msgid ""
"\n"
"Context: Save account\n"
"Database ID: %(database_id)s\n"
"Problem: The foreign currency set on journal '%(journal)s' and account\n"
"    '%(account)s' must be the same\n"
"Solution: Align the account currency with its journal's currency\n"
msgstr ""

#. module: ssi_accounting
#. odoo-python
#: code:addons/ssi_accounting/models/account_group.py:0
msgid ""
"\n"
"Context: Save account group\n"
"Database ID: %(database_id)s\n"
"Problem: Code prefix range %(start)s-%(end)s overlaps with another\n"
"    account group of the same length in the same company\n"
"Solution: Adjust the code prefix range so it does not overlap with an\n"
"    existing account group\n"
msgstr ""

#. module: ssi_accounting
#. odoo-python
#: code:addons/ssi_accounting/models/account_group.py:0
msgid ""
"\n"
"Context: Save account group\n"
"Database ID: %(database_id)s\n"
"Problem: Starting code prefix \"%(start)s\" and ending code prefix\n"
"    \"%(end)s\" do not have the same length\n"
"Solution: Make sure both code prefixes have the same number of\n"
"    characters\n"
msgstr ""

#. module: ssi_accounting
#. odoo-python
#: code:addons/ssi_accounting/models/account_group.py:0
msgid ""
"\n"
"Context: Save account group\n"
"Database ID: %(database_id)s\n"
"Problem: The parent group hierarchy is recursive\n"
"Solution: Pick a parent group that is not one of this group's own\n"
"    descendants\n"
msgstr ""

#. module: ssi_accounting
#. odoo-python
#: code:addons/ssi_accounting/models/account_tag.py:0
msgid ""
"\n"
"Context: Save account tag\n"
"Database ID: %(database_id)s\n"
"Problem: Another account tag with the same name, applicability and\n"
"    country already exists\n"
"Solution: Choose a different name or applicability, or clear the\n"
"    country for a tag available to every country\n"
msgstr ""

#. module: ssi_accounting
#. odoo-python
#: code:addons/ssi_accounting/models/journal.py:0
msgid ""
"\n"
"Context: Save journal\n"
"Database ID: %(database_id)s\n"
"Problem: The default account of a journal cannot be of type Receivable\n"
"    or Payable\n"
"Solution: Pick a different default account\n"
msgstr ""

#. module: ssi_accounting
#. odoo-python
#: code:addons/ssi_accounting/models/journal_entry.py:0
msgid ""
"\n"
"Context: Save journal entry\n"
"Database ID: %(database_id)s\n"
"Problem: The following journal entries are not balanced (sum of debit\n"
"    minus credit is not zero):\n"
"%(lines)s\n"
"Solution: Adjust the lines' debit/credit so each entry balances to zero,\n"
"    or set a suspense account on the journal to auto-balance drafts\n"
msgstr ""

#. module: ssi_accounting
#. odoo-python
#: code:addons/ssi_accounting/models/tax_repartition_line.py:0
msgid ""
"\n"
"Context: Save tax repartition line\n"
"Database ID: %(database_id)s\n"
"Problem: The total factor of the %(group)s repartition lines is\n"
"    %(total)s%%, it must be exactly 100%%\n"
"Solution: Adjust the factor of each %(group)s repartition line so their\n"
"    total equals 100%%\n"
msgstr ""

#. module: ssi_accounting
#. odoo-python
#: code:addons/ssi_accounting/models/account.py:0
msgid ""
"\n"
"Context: Update account companies\n"
"Database ID: %(database_id)s\n"
"Problem: This account already has journal items linked to a company being\n"
"    removed\n"
"Solution: Keep the company assigned, or first remove/reassign the journal\n"
"    items using it\n"
msgstr ""

#. module: ssi_accounting
#. odoo-python
#: code:addons/ssi_accounting/models/account.py:0
msgid ""
"\n"
"Context: Update account currency\n"
"Database ID: %(database_id)s\n"
"Problem: This account already has journal entries in a different foreign\n"
"    currency\n"
"Solution: Keep the current currency, or first reassign the existing journal\n"
"    items\n"
msgstr ""

#. module: ssi_accounting
#. odoo-python
#: code:addons/ssi_accounting/models/journal.py:0
msgid ""
"\n"
"Context: Update journal company\n"
"Database ID: %(database_id)s\n"
"Problem: This journal already contains journal entries, therefore its\n"
"    company cannot be changed\n"
"Solution: Keep the current company, or create a new journal in the\n"
"    target company instead\n"
msgstr ""

#. module: ssi_accounting
#. odoo-python
#: code:addons/ssi_accounting/models/journal.py:0
msgid ""
"\n"
"Context: Update journal company\n"
"Database ID: %(database_id)s\n"
"Problem: This journal already has journal entries linked to a different\n"
"    company\n"
"Solution: Keep the current company, or first reassign the journal\n"
"    entries\n"
msgstr ""

#. module: ssi_accounting
#. odoo-python
#: code:addons/ssi_accounting/models/mixin_sequence_number.py:0
msgid ""
"\n"
"Document Type: %(document_type)s\n"
"Context: Validate document number against its accounting date\n"
"Database ID: %(database_id)s\n"
"Problem: %(date_field)s (%(date)s)\n"
"is not aligned with the existing document number (%(sequence)s)\n"
"Solution: Clear the document number, or select the affected entries and\n"
"use the resequence option from the actions menu (developer mode) to\n"
"realign the numbering with the dates\n"
msgstr ""

