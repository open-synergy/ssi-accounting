<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Global multi-company isolation: account.journal.company_id is
         required, so a plain company_id-in-allowed-companies domain is
         enough. No `groups` field on purpose -> applies to every user,
         same as the other multi-company rules shipped by Odoo core. -->
    <record id="account_journal_multi_company_rule" model="ir.rule">
        <field name="name">Journal - Multi Company</field>
        <field name="model_id" ref="model_account_journal" />
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
