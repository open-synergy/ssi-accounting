<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="module_category_accounting" model="ir.module.category">
        <field name="name">Accounting</field>
    </record>

    <record id="res_groups_privilege_accounting" model="res.groups.privilege">
        <field name="name">Accounting</field>
        <field name="category_id" ref="module_category_accounting" />
    </record>

    <record id="group_accounting_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="res_groups_privilege_accounting" />
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]" />
    </record>

    <record id="group_accounting_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="res_groups_privilege_accounting" />
        <field name="implied_ids" eval="[(4, ref('group_accounting_user'))]" />
        <field
            name="user_ids"
            eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"
        />
    </record>
</odoo>
