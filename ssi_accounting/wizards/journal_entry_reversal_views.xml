<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="journal_entry_reversal_view_form" model="ir.ui.view">
        <field name="name">journal_entry_reversal - form</field>
        <field name="model">journal_entry_reversal</field>
        <field name="arch" type="xml">
            <form string="Reverse Entry">
                <group name="main_group">
                    <field
                        name="move_ids"
                        widget="many2many_tags"
                        domain="[('state', '=', 'posted')]"
                    />
                    <field name="date" />
                    <field name="journal_id" />
                    <field name="reason" />
                    <field name="refund_method" widget="radio" />
                </group>
                <footer>
                    <button
                        name="action_reverse_moves"
                        string="Reverse"
                        type="object"
                        class="oe_highlight"
                    />
                    <button string="Cancel" class="oe_link" special="cancel" />
                </footer>
            </form>
        </field>
    </record>
</odoo>
